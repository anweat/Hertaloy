{
  "templates": [
    {
      "id": "root",
      "kind": "root_config",
      "spec": {
        "nodes": {
          "gather": {
            "kind": "handler",
            "handler": "collect",
            "ports": {
              "in": {
                "direction": "receive",
                "servo": {
                  "vars": {
                    "value": { "type": "short", "from": "$.value" },
                    "expect": { "type": "short", "from": "$.expect" }
                  }
                }
              },
              "done": { "direction": "emit" }
            }
          },
          "sink": {
            "kind": "handler",
            "handler": "noop",
            "ports": { "in": { "direction": "receive" } }
          }
        },
        "edges": {
          "e1": { "from": { "node": "gather", "port": "done" }, "to": { "node": "sink", "port": "in" } }
        }
      }
    }
  ],
  "root": { "template": "root", "id": "job-1" },
  "send": [
    { "traceid": "job-1", "node": "gather", "port": "in", "payload": { "value": "a", "expect": 3 } },
    { "traceid": "job-1", "node": "gather", "port": "in", "payload": { "value": "b", "expect": 3 } },
    { "traceid": "job-1", "node": "gather", "port": "in", "payload": { "value": "c", "expect": 3 } }
  ]
}
