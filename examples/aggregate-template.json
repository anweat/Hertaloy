{
  "nodes": {
    "gather": {
      "kind": "handler",
      "handler": "collect",
      "ports": {
        "in": {
          "direction": "receive",
          "servo": {
            "vars": {
              "value": {
                "type": "short",
                "from": "$.value"
              },
              "expect": {
                "type": "short",
                "from": "$.expect"
              }
            }
          }
        },
        "done": {
          "direction": "emit"
        }
      }
    },
    "sink": {
      "kind": "handler",
      "handler": "noop",
      "ports": {
        "in": {
          "direction": "receive"
        }
      }
    }
  },
  "edges": {
    "e1": {
      "from": {
        "node": "gather",
        "port": "done"
      },
      "to": {
        "node": "sink",
        "port": "in"
      }
    }
  }
}